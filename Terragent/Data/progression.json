    {
      "key": "wood",
      "kind": "Item",
      "label": "Gather Wood",
      "requires": [
        "starting_tools"
      ],
      "item": "Wood",
      "count": 100,
      "effort": 2.0,
      "note": "About ten trees. A bench is ten, a furnace wants four and three torches, arrows are one wood for five, and every one of those errands used to send the agent back to the treeline mid-recipe. Cutting a stack up front is one walk instead of six."
    },
    {
      "key": "torch",
      "kind": "Item",
      "label": "Torch",
      "requires": [
        "wood"
      ],
      "item": "Torch",
      "count": 1,
      "keeps": [
        "torch_1"
      ],
      "effort": 1.0,
      "note": "One torch, held, is a lamp, and a lit cell is a revealed cell, so this is the difference between an agent that can see what it is standing in and one that is blind. It carries the supply that keeps it that way, because a standing requirement cannot be the thing that gets itself started: as a requirement and nothing else it worked only while restocking stopped everything until it was met, and competing with the rest of the board it loses every tick underground, where no gel walks past. The run this was written for went down for iron with none, read Unknown for every cell, swung seventy nine times at a hole it had already dug and wrote the tile off as too hard for the pickaxe."
    },
    {
      "key": "bow",
      "kind": "Item",
      "label": "Wooden Bow",
      "requires": [
        "torch"
      ],
      "item": "WoodenBow",
      "keeps": [
        "arrows",
        "glowsticks"
      ],
      "effort": 0.5,
      "note": "Demon Eyes fly and a Copper Shortsword reaches 26px, so a melee-only agent holds position waiting for something that hovers. Finishing it starts the arrows, with the first five already made: running dry mid-fight is what a bow is for."
    },
