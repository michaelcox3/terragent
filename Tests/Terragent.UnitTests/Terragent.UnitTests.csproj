<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything here runs with no game, no Terraria reference and no world. The recipe tree
    is arithmetic over a table of formulas, written out by hand; the search is arithmetic
    over a picture of ground, typed out as text. Both take what they need as arguments,
    which is what lets them be checked at all.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Terragent.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />

    <!-- Point, Rectangle and Vector2 only. In game those come from the FNA in the
         tModLoader install; here from MonoGame, which reimplements the same XNA namespace
         and is on NuGet, so none of this needs the game installed. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled from the mod rather than copied: a copy would drift. -->
    <Compile Include="..\..\Terragent\World\IRecipeTree.cs" />
    <Compile Include="..\..\Terragent\World\RecipeTree.cs" />
    <Compile Include="..\..\Terragent\Pathfinding\Ability.cs" />
    <Compile Include="..\..\Terragent\Pathfinding\INavigator.cs" />
    <Compile Include="..\..\Terragent\Pathfinding\Navigator.cs" />
    <Compile Include="..\..\Terragent\Pathfinding\Route.cs" />
    <Compile Include="..\..\Terragent\Pathfinding\RouteMatch.cs" />
    <Compile Include="..\..\Terragent\Pathfinding\Step.cs" />
    <Compile Include="..\..\Terragent\Pathfinding\Costs.cs" />
    <Compile Include="..\..\Terragent\Pathfinding\Leap.cs" />
    <Compile Include="..\..\Terragent\World\Hitbox.cs" />
    <Compile Include="..\..\Terragent\World\Spot.cs" />
    <Compile Include="..\..\Terragent\World\ITerrain.cs" />
    <Compile Include="..\..\Terragent\World\TileKind.cs" />
    <Compile Include="..\..\Terragent\World\Ground.cs" />
    <Compile Include="..\..\Terragent\World\CraftingRecipe.cs" />
    <Compile Include="..\..\Terragent\World\RecipeNode.cs" />
    <Compile Include="..\..\Terragent\World\NeededItem.cs" />
    <Compile Include="..\..\Terragent\Pathfinding\StepKind.cs" />
    <Compile Include="..\..\Terragent\Pathfinding\Edge.cs" />
    <Compile Include="..\..\Terragent\Pathfinding\Destination.cs" />

    <Compile Include="..\..\Terragent\Tests\Scenarios.cs" />
    <Compile Include="GlobalUsings.cs" />
    <Compile Include="Grid.cs" />
    <Compile Include="RecipeTreeTests.cs" />
    <Compile Include="NavigatorTests.cs" />
    <Compile Include="CostsTests.cs" />
    <Compile Include="SpotTests.cs" />
    <Compile Include="HitboxTests.cs" />
  </ItemGroup>

</Project>
